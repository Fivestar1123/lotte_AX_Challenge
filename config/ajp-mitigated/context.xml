<?xml version="1.0" encoding="UTF-8"?>
<!--
  시나리오 B: Tomcat 기본 context.xml 그대로 — PersistentManager/FileStore를
  전혀 설정하지 않음(세션은 기본 StandardManager로 메모리에만 보관).
  CVE-2020-9484의 전제조건 b)가 성립하지 않는다.
-->
<Context>
  <WatchedResource>WEB-INF/web.xml</WatchedResource>
  <WatchedResource>${catalina.base}/conf/web.xml</WatchedResource>
  <WatchedResource>${catalina.base}/conf/context.xml</WatchedResource>

  <!-- Uncomment this to disable session persistence across Tomcat restarts -->
  <!--
  <Manager pathname="" />
  -->
</Context>
