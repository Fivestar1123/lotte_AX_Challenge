# LLM 조치안 생성용 설정. 실제 키가 들어간 .env는 절대 커밋하지 말 것 (.gitignore에 추가).

# openai | anthropic | offline  (offline 또는 키 미설정 시 템플릿 기반으로 자동 degrade)
LLM_PROVIDER=openai

# OpenAI 기본 모델. Anthropic으로 바꿀 경우 LLM_PROVIDER=anthropic + 아래 모델명도 교체
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 상위 몇 건까지만 LLM 호출할지 (비용/환각 통제)
REMEDIATE_TOP_N=3
